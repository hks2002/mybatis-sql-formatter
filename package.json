{
  "name": "mybatis-sql-formatter",
  "displayName": "MyBatis SQL Formatter",
  "description": "format MyBatis tag mixed with SQL",
  "publisher": "MerBleueAviation",
  "license": "MIT",
  "version": "1.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hks2002/mybatis-sql-formatter.git"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mybatis",
    "sql",
    "formatter"
  ],
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt --write",
    "cspell": "cspell .",
    "build": "node esbuild.js",
    "dev": "node esbuild.js --watch",
    "pretest": "pnpm run lint && pnpm run build",
    "test": "node ./test/runTest.js",
    "vscode:prepublish": "pnpm run build",
    "publish": "vsce publish --skip-duplicate --no-dependencies",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "sql-formatter": "^15.7.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "cspell": "^9.6.0",
    "esbuild": "^0.28.1",
    "fast-glob": "3.3.3",
    "mocha": "^10.1.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:sql"
  ],
  "l10n": "l10n",
  "contributes": {
    "commands": [
      {
        "command": "mybatis-sql-formatter.format",
        "title": "Format MyBatis SQL"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "MyBatis SQL Formatter",
      "properties": {
        "mybatis-sql-formatter.dialect": {
          "order": 0,
          "type": "string",
          "enum": [
            "sql",
            "mysql",
            "mariadb",
            "tidb",
            "postgresql",
            "redshift",
            "sqlite",
            "transactsql",
            "plsql",
            "db2",
            "db2i",
            "bigquery",
            "hive",
            "spark",
            "snowflake",
            "trino",
            "duckdb",
            "n1ql",
            "singlestoredb"
          ],
          "default": "sql",
          "description": "%mybatis-sql-formatter.dialect%"
        },
        "mybatis-sql-formatter.tabWidth": {
          "order": 1,
          "type": "number",
          "default": 2,
          "description": "%mybatis-sql-formatter.tabWidth%"
        },
        "mybatis-sql-formatter.useTabs": {
          "order": 3,
          "type": "boolean",
          "default": false,
          "description": "%mybatis-sql-formatter.useTabs%"
        },
        "mybatis-sql-formatter.keywordCase": {
          "order": 4,
          "type": "string",
          "enum": [
            "preserve",
            "upper",
            "lower"
          ],
          "default": "preserve",
          "description": "%mybatis-sql-formatter.keywordCase%"
        },
        "mybatis-sql-formatter.identifierCase": {
          "order": 5,
          "type": "string",
          "enum": [
            "preserve",
            "upper",
            "lower"
          ],
          "default": "preserve",
          "description": "%mybatis-sql-formatter.identifierCase%"
        },
        "mybatis-sql-formatter.dataTypeCase": {
          "order": 6,
          "type": "string",
          "enum": [
            "preserve",
            "upper",
            "lower"
          ],
          "default": "preserve",
          "description": "%mybatis-sql-formatter.dataTypeCase%"
        },
        "mybatis-sql-formatter.functionCase": {
          "order": 7,
          "type": "string",
          "enum": [
            "preserve",
            "upper",
            "lower"
          ],
          "default": "preserve",
          "description": "%mybatis-sql-formatter.functionCase%"
        },
        "mybatis-sql-formatter.indentStyle": {
          "order": 8,
          "type": "string",
          "enum": [
            "standard",
            "tabularLeft",
            "tabularRight"
          ],
          "default": "standard",
          "description": "%mybatis-sql-formatter.indentStyle%"
        },
        "mybatis-sql-formatter.logicalOperatorNewline": {
          "order": 9,
          "type": "string",
          "enum": [
            "before",
            "after"
          ],
          "default": "before",
          "description": "%mybatis-sql-formatter.logicalOperatorNewline%"
        },
        "mybatis-sql-formatter.expressionWidth": {
          "order": 10,
          "type": "number",
          "default": 50,
          "description": "%mybatis-sql-formatter.expressionWidth%"
        },
        "mybatis-sql-formatter.linesBetweenQueries": {
          "order": 11,
          "type": "number",
          "default": 1,
          "description": "%mybatis-sql-formatter.linesBetweenQueries%"
        },
        "mybatis-sql-formatter.denseOperators": {
          "order": 12,
          "type": "boolean",
          "default": false,
          "description": "%mybatis-sql-formatter.denseOperators%"
        },
        "mybatis-sql-formatter.newlineBeforeSemicolon": {
          "order": 13,
          "type": "boolean",
          "default": false,
          "description": "%mybatis-sql-formatter.newlineBeforeSemicolon%"
        }
      }
    },
    "keybindings": [
      {
        "command": "mybatis-sql-formatter.format",
        "key": "ctrl+win+f",
        "mac": "ctrl+cmd+f",
        "linux": "ctrl+meta+f",
        "when": "editorTextFocus"
      }
    ]
  }
}